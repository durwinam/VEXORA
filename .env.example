VEXORA_VERSION=1.0.0
VEXORA_HOST=0.0.0.0
VEXORA_PORT=6000

VEXORA_SECRET_KEY=CHANGE_ME
VEXORA_ADMIN_USERNAME=owner
VEXORA_ADMIN_PASSWORD_HASH=CHANGE_ME

VEXORA_DATABASE=/var/lib/vexora/vexora.db

VEXORA_CERT_FILE=/etc/vexora/certs/fullchain.pem
VEXORA_KEY_FILE=/etc/vexora/certs/privkey.pem

VEXORA_HTTPS_PORT=443
VEXORA_HTTPS_ALT_PORT=8443
