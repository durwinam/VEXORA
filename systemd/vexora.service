[Unit]
Description=VEXORA Configuration Shop
After=network.target
[Service]
Type=simple
WorkingDirectory=/opt/vexora
EnvironmentFile=/etc/vexora/.env
ExecStart=/opt/vexora/.venv/bin/uvicorn app.main:app --host ${VEXORA_HOST} --port ${VEXORA_PORT} --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
